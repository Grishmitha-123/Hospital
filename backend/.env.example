# Copy to .env and adjust. NEVER commit the real .env.

# PostgreSQL connection (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://medicare:change_me@127.0.0.1:5432/medicare

# Auth — the single admin account used by the frontend login
ADMIN_EMAIL=admin@medicare.ai
ADMIN_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=480

# CORS for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auto-refresh hint for the frontend (ms)
REFRESH_INTERVAL_MS=60000
